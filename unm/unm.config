# 独立编译 luci-app-unblockneteasemusic 用的最小配置
# 只用于 build_unm_pkg.yml, 不参与固件构建
# 关键: target 必须与固件一致(x86_64 Generic), 否则编出的 node 无法在固件上运行

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
# x86/64 的 profile 有两种写法, 随源码版本变化:
#   旧版: target/linux/x86/64/target.mk 里有 `define Profile/Generic` -> CONFIG_TARGET_x86_64_Generic
#   新版: 只保留 image/64.mk 的 `define Device/generic` + TARGET_DEVICES
#         -> profile id 变成 DEVICE_generic, 符号是 CONFIG_TARGET_x86_64_DEVICE_generic
# 两个都写上: 不存在的那一个会被 kconfig 当作未知符号直接丢弃, 不影响构建。
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 固件使用 UEFI 引导, 保持一致(对单包编译无实质影响, 但避免 defconfig 反复改动)
CONFIG_EFI_IMAGES=y

# 插件本体(JS 版 v3.4), 直接取自 LEDE luci feed, 不需要另 clone 上游仓库
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y

# 插件的 LUCI_DEPENDS 含 @PACKAGE_firewall4, 缺它该包在 menuconfig 里不可选,
# 会被 defconfig 直接丢掉。x86(target DEVICE_TYPE=router) 默认已含, 此处显式固化。
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
# ucode 包同时提供 utpl(nftables.ut 模板渲染器), v3.4 的 fw4 分流路径依赖它
CONFIG_PACKAGE_ucode=y

# 运行时依赖: 插件依赖 dnsmasq-full, 这里保留符号便于 defconfig 不报未知符号
CONFIG_PACKAGE_dnsmasq-full=y

# node 运行时: 插件启动命令为 `node core/app.js`, 必须随 ipk 一起安装
CONFIG_PACKAGE_node=y

# 加速项: 让 host 端 node 直接使用 nodejs.org 的 linux-x64 预编译包,
# 跳过 host 自举编译(省 10-20 分钟)。runner 为 x86_64, 与预编译包架构一致。
# 若该符号在你的源码中未定义, make defconfig 会自动丢弃, 不影响构建结果。
CONFIG_NODEJS_HOST_BIN=y

# 说明: 不选 node-npm。插件运行 app.js 不需要 npm, 选中会显著增大体积与编译时间。
# CONFIG_PACKAGE_node-npm is not set
